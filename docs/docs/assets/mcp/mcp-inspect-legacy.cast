[7.41875, "o", "\r\n\u001b[32m\u001b[40m mcp         \u001b[34m Manage MCP runtime servers (/mcp list|connect|disconnect|reconnect)                              \u001b[38;5;16m\u001b[48;5;238m \u001b[14;1H\u001b[32m\u001b[40m connect     \u001b[34m Alias for /mcp connect with target auto-detection                                                \u001b[38;5;16m\u001b[48;5;238m \u001b[15;1H\u001b[32m\u001b[40m history     \u001b[34m Show conversation history overview (or /history show|detail|save|load|clear|rewind|fix)          \u001b[38;5;16m\u001b[48;5;238m \u001b[16;1H\u001b[32m\u001b[40m compact     \u001b[34m Compact history into a checkpoint summary (/compact preview|prompt)                              \u001b[38;5;16m\u001b[48;5;238m \u001b[17;1H\u001b[32m\u001b[40m tools       \u001b[34m List tools or show a tool's JSON schema                                                          \u001b[38;5;16m\u001b[48;5;238m \u001b[18;1H\u001b[32m\u001b[40m model       \u001b[34m Model inspection, switching, and runtime settings (/model, /model task_budget 64k, /model swi... \u001b[38;5;16m\u001b[48;5;238m \u001b[19;1H\u001b[32m\u001b[40m check       \u001b[34m Config diagnostics (/check, /check run)                                                          \u001b[38;5;16m\u001b[48;5;238m \u001b[20;1H\u001b[32m\u001b[40m commands    \u001b[34m Show command map and detailed command help                                                       \u001b[38;5;16m\u001b[48;5;238m \u001b[21;1H\u001b[32m\u001b[40m skills      \u001b[34m Manage local skills (/skills, /skills available, /skills search docker, /skills add <number|n... \u001b[38;5;16m\u001b[48;5;238m \u001b[22;1H\u001b[32m\u001b[40m packs       \u001b[34m Manage card packs (/packs, /packs add <number|name>, /packs readme <number|name>, /packs upda... \u001b[38;5;16m\u001b[48;5;238m \u001b[23;1H\u001b[32m\u001b[40m plugins     \u001b[34m Manage command plugins (/plugins, /plugins available, /plugins add <number|name>, /plugins re... \u001b[38;5;16m\u001b[48;5;248m \u001b[24;1H\u001b[32m\u001b[40m prompt      \u001b[34m Load a Prompt File or use MCP Prompt                                                             \u001b[38;5;16m\u001b[48;5;248m \u001b[25;1H\u001b[32m\u001b[40m attach      \u001b[34m Stage file paths or remote URL attachments for the next prompt                                   \u001b[38;5;16m\u001b[48;5;248m \u001b[26;1H\u001b[32m\u001b[40m system      \u001b[34m Show the current system prompt                                                                   \u001b[38;5;16m\u001b[48;5;248m \u001b[27;1H\u001b[32m\u001b[40m usage       \u001b[34m Show current usage statistics                                                                    \u001b[38;5;16m\u001b[48;5;248m \u001b[28;1H\u001b[32m\u001b[40m markdown    \u001b[34m Show last assistant message without markdown formatting                                          \u001b[38;5;16m\u001b[48;5;248m \u001b[12;4H\u001b(B\u001b[m"]
