[15.802098, "o", "\u001b[Hbash-5.3$ fast-agent --model passthrough                                                                      \u001b[1;84H\u001b[30m\u001b[43m22:15 [461/461] (1 results)\u001b[2;1H\u001b[39m\u001b[49mCTRL+T \u001b[2mmultiline, \u001b(B\u001b[mCTRL+Y\u001b[2m copy last message, \u001b(B\u001b[mCTRL+E\u001b[2m external editor.\u001b(B\u001b[m                                           \u001b[3;1HCTRL+C\u001b[2m to interrupt generation or background waiting, \u001b(B\u001b[mCTRL+D\u001b[2m to exit.\u001b(B\u001b[m                                         \u001b[4;1HCTRL+Space\u001b[2m or \u001b(B\u001b[mTab\u001b[2m for path completion.\u001b(B\u001b[m                                                                        \u001b[5;1H\u001b[2mUse \u001b(B\u001b[m\u001b[35m/\u001b[95mattach\u001b[39m\u001b[2m, \u001b[32m'\u001b(B\u001b[m\u001b[32m^file:\u001b[2m'\u001b[39m, or \u001b[32m'\u001b(B\u001b[m\u001b[32m^url:\u001b[2m'\u001b[39m for attachments.\u001b(B\u001b[m F10\u001b[2m to clear.\u001b(B\u001b[m                                              \u001b[6;1H\u001b[2mUse \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m/\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m for commands, \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m!\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m for shell. \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m#\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m to query, \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m@\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m to switch agents\u001b(B\u001b[m                                       \u001b[7;1H                                                                                                              \u001b[8;1H\u001b[33m\u001b[1mAgents have shell\u001b(B\u001b[m\u001b[2m (skills, bash | env: local local | cwd: /tmp/tmp.fGJsoffaSB)\u001b(B\u001b[m                                \u001b[9;1H\u001b[2mAgent \u001b(B\u001b[m\u001b[34magent\u001b[39m\u001b[2m: \u001b(B\u001b[m\u001b[96m\u001b[1m2\u001b(B\u001b[m\u001b[2m skills installed\u001b(B\u001b[m                                                                               \u001b[10;1H\u001b[2mStreaming Enabled - markdown mode\u001b(B\u001b[m                                                                             \u001b[11;1H                                                                                                              \u001b[12;1H\u001b[2m❯ \u001b[35m/\u001b[95mmcp\u001b[39m connect \u001b[94m\u001b[4mhttp://localhost:3000/mcp\u001b(B\u001b[m\u001b[2m --name hf\u001b(B\u001b[m                                                            \u001b[13;1HConnected MCP server 'hf' (url).                                                                              \u001b[14;1H\u001b[2mAdded \u001b(B\u001b[m\u001b[96m\u001b[1m4\u001b(B\u001b[m\u001b[2m tools and \u001b(B\u001b[m\u001b[96m\u001b[1m0\u001b(B\u001b[m\u001b[2m prompts; \u001b(B\u001b[m\u001b[96m\u001b[1m25\u001b(B\u001b[m\u001b[2m skills available from the server.\u001b(B\u001b[m                                             \u001b[15;1H\u001b[2m❯ \u001b[35m/\u001b[95mtool\u001b[39m hf__hf_whoami\u001b(B\u001b[m                                                                                         \u001b[16;1H                                                                                                              \u001b[17;1H\u001b[32m▎\u001b[2m◀\u001b(B\u001b[m \u001b[32magent\u001b[39m \u001b[2mtools\u001b(B\u001b[m                                                                                                \u001b[18;1H                                          \u001b[33m\u001b[1m\u001b[4mTool schema: hf__hf_whoami\u001b(B\u001b[m                                          \u001b[19;1H                                                                                                              \u001b[20;1H\u001b[33m\u001b[4mInput schema\u001b(B\u001b[m                                                                                                  \u001b[21;1H\u001b[48;2;32;32;32m                                                                                                              \u001b[22;1H\u001b[38;2;208;208;208m{\u001b[39m                                                                                                             \u001b[23;1H\u001b[38;2;102;102;102m  \u001b[38;2;110;191;38m\u001b[1m\"type\"\u001b(B\u001b[m\u001b[38;2;208;208;208m\u001b[48;2;32;32;32m:\u001b[38;2;102;102;102m \u001b[38;2;237;157;19m\"object\"\u001b[38;2;208;208;208m,\u001b[39m                                                                                           \u001b[24;1H\u001b[38;2;102;102;102m  \u001b[38;2;110;191;38m\u001b[1m\"$schema\"\u001b(B\u001b[m\u001b[38;2;208;208;208m\u001b[48;2;32;32;32m:\u001b[38;2;102;102;102m \u001b[38;2;237;157;19m\"https://json-schema.org/draft/2020-12/schema\"\u001b[38;2;208;208;208m,\u001b[39m                                                  \u001b[25;1H\u001b[38;2;102;102;102m  \u001b[38;2;110;191;38m\u001b[1m\"properties\"\u001b(B\u001b[m\u001b[38;2;208;208;208m\u001b[48;2;32;32;32m:\u001b[38;2;102;102;102m \u001b[38;2;208;208;208m{}\u001b[39m                                                                                            \u001b[26;1H\u001b[38;2;208;208"]
