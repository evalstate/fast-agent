[5.017371, "o", "\u001b[?25l\u001b[Hbash-5.3$ fast-agent --model passthrough\u001b[K\r\nCTRL+T \u001b[2mmultiline, \u001b(B\u001b[mCTRL+Y\u001b[2m copy last message, \u001b(B\u001b[mCTRL+E\u001b[2m external editor.\u001b(B\u001b[m\u001b[K\r\nCTRL+C\u001b[2m to interrupt generation or background waiting, \u001b(B\u001b[mCTRL+D\u001b[2m to exit.\u001b(B\u001b[m\u001b[K\r\nCTRL+Space\u001b[2m or \u001b(B\u001b[mTab\u001b[2m for path completion.\u001b(B\u001b[m\u001b[K\u001b[2m\r\nUse \u001b(B\u001b[m\u001b[35m/\u001b[95mattach\u001b[39m\u001b[2m, \u001b[32m'\u001b(B\u001b[m\u001b[32m^file:\u001b[2m'\u001b[39m, or \u001b[32m'\u001b(B\u001b[m\u001b[32m^url:\u001b[2m'\u001b[39m for attachments.\u001b(B\u001b[m F10\u001b[2m to clear.\u001b(B\u001b[m\u001b[K\u001b[2m\r\nUse \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m/\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m for commands, \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m!\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m for shell. \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m#\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m to query, \u001b[32m'\u001b(B\u001b[m\u001b[32m\u001b[1m@\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m to switch agents\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[33m\u001b[1m\r\nAgents have shell\u001b(B\u001b[m\u001b[2m (skills, bash | env: local local | cwd: /tmp/tmp.fGJsoffaSB)\u001b(B\u001b[m\u001b[K\u001b[2m\r\nAgent \u001b(B\u001b[m\u001b[34magent\u001b[39m\u001b[2m: \u001b(B\u001b[m\u001b[96m\u001b[1m2\u001b(B\u001b[m\u001b[2m skills installed\u001b(B\u001b[m\u001b[K\u001b[2m\r\nStreaming Enabled - markdown mode\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[93m\r\n❯\u001b[39m\u001b[1X\u001b[C/mcp\u001b[1X\u001b[Cconnect\u001b[1X\u001b[Chttp://local\u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n \u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u00