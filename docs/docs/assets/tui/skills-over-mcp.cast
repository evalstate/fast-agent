[7.440497, "o", "\u001b[13;32H\u001b[32m\u001b[40m --name         \u001b[34m set attached server name                       \u001b[38;5;16m\u001b[48;5;238m \u001b[14;32H\u001b[32m\u001b[40m -n             \u001b[34m set attached server name                       \u001b[38;5;16m\u001b[48;5;238m \u001b[15;32H\u001b[32m\u001b[40m --auth         \u001b[34m set bearer token for URL servers               \u001b[38;5;16m\u001b[48;5;238m \u001b[16;32H\u001b[32m\u001b[40m --timeout      \u001b[34m set startup timeout in seconds                 \u001b[38;5;16m\u001b[48;5;238m \u001b[17;32H\u001b[32m\u001b[40m --protocol     \u001b[34m set MCP protocol mode: auto, modern, or legacy \u001b[38;5;16m\u001b[48;5;238m \u001b[18;32H\u001b[32m\u001b[40m --oauth        \u001b[34m enable oauth flow                              \u001b[38;5;16m\u001b[48;5;238m \u001b[19;32H\u001b[32m\u001b[40m --no-oauth     \u001b[34m disable oauth flow                             \u001b[38;5;16m\u001b[48;5;238m \u001b[20;32H\u001b[32m\u001b[40m --reconnect    \u001b[34m force reconnect and refresh tools              \u001b[38;5;16m\u001b[48;5;238m \u001b[21;32H\u001b[32m\u001b[40m --no-reconnect \u001b[34m disable reconnect-on-disconnect                \u001b[38;5;16m\u001b[48;5;238m \u001b[12;43H\u001b(B\u001b[m"]
