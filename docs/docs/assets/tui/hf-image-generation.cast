[4.508085, "o", "CTRL+T \u001b[2mmultiline, \u001b(B\u001b[mCTRL+Y\u001b[2m copy last message, \u001b(B\u001b[mCTRL+E\u001b[2m external editor.\r\n\u001b(B\u001b[mCTRL+C\u001b[2m to interrupt generation or background waiting, \u001b(B\u001b[mCTRL+D\u001b[2m to exit.\r\n\u001b(B\u001b[mCTRL+Space\u001b[2m or \u001b(B\u001b[mTab\u001b[2m for path completion.\r\nUse \u001b(B\u001b[m\u001b[35m/\u001b[95mattach\u001b[39m\u001b[2m, \u001b[32m'\u001b(B\u001b[m\u001b[32m^file:\u001b[2m'\u001b[39m, \u001b[32m'\u001b(B\u001b[m\u001b[32m^url:\u001b[2m'\u001b[39m, or Ctrl+Alt+V to paste attachments. F10 to clear.\r\nUse \u001b[32m'\u001b[1m/\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m for commands, \u001b[32m'\u001b[1m!\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m for shell. \u001b[32m'\u001b[1m#\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m to query, \u001b[32m'\u001b[1m@\u001b(B\u001b[m\u001b[32m\u001b[2m'\u001b[39m to switch agents\u001b[8;1H\u001b(B\u001b[m\u001b[2mModel shortcuts:\r\n\u001b(B\u001b[m  Shift+Tab\u001b[2m = Service tier \u001b[1m(\u001b(B\u001b[m\u001b[2mstandard, fast\u001b[1m)\r\n\u001b(B\u001b[m"]
