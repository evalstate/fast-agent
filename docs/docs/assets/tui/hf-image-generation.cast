[5.197005, "o", "\u001b[?7727h\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;34r\u001b[18;3H\u001b[?25l\u001b[Hbash-5.3$ fast-agent -x --model codexplan\u001b[K\r\nCTRL+T \u001b[2mmultiline, \u001b(B\u001b[mCTRL+Y\u001b[2m copy last message, \u001b(B\u001b[mCTRL+E\u001b[2m external editor.\u001b(B\u001b[m\u001b[K\r\nCTRL+C\u001b[2m to interrupt generation or background waiting, \u001b(B\u001b[mCTRL+D\u001b[2m to exit.\u001b(B\u001b[m\u001b[K\r\nCTRL+Space\u001b[2m or \u001b(B\u001b[mTab\u001b[2m for path completion.\u001b(B\u001b[m\u001b[K\u001b[2m\r\nUse \u001b(B\u001b[m\u001b[35m/\u001b[95mattach\u001b[39m\u001b[2m, \u001b[32m'\u001b(B\u001b[m\u001b[32m^file:\u001b[2m'\u001b[39m, \u001b[32m'\u001b(B\u001b[m\u001b[32m^url:\u001b[2m'\u001b[39m, or Ctrl+Alt+V to paste attachments. F10 to clear.\u001b(B\u001b[m\u001b[K\u001b[2m\r\nUse \u001b[32m'/'\u001b[39m for commands, \u001b[32m'!'\u001b[39m for shell. \u001b[32m'#'\u001b[39m to query, \u001b[32m'@'\u001b[39m to switch agents\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[2m\r\nModel shortcuts:\u001b(B\u001b[m\u001b[K\r\n  Shift+Tab\u001b[2m = Service tier \u001b[1m(\u001b(B\u001b[m\u001b[2mstandard, fast\u001b[1m)\u001b(B\u001b[m\u001b[K\r\n  F6\u001b[2m = Reasoning \u001b[1m(\u001b(B\u001b[m\u001b[2mnone, low, medium, high, xhigh, max\u001b[1m)\u001b(B\u001b[m\u001b[K\r\n  F7\u001b[2m = Verbosity \u001b[1m(\u001b(B\u001b[m\u001b[2mlow, medium, high\u001b[1m)\u001b(B\u001b[m\u001b[K\r\n  F8\u001b[2m = Web search \u001b[1m(\u001b(B\u001b[m\u001b[2mon, off\u001b[1m)\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[33m\u001b[1m\r\nAgents have shell\u001b(B\u001b[m\u001b[2m (skills, switch, bash | env: local local | cwd: /tmp/tmp.iV8iADls8c)\u001b(B\u001b[m\u001b[K\u001b[2m\r\nAgent \u001b(B\u001b[m\u001b[34magent\u001b[39m\u001b[2m: \u001b(B\u001b[m\u001b[96m\u001b[1m1\u001b(B\u001b[m\u001b[2m skill installed\u001b(B\u001b[m\u001b[K\u001b[2m\r\nStreaming Enabled - m